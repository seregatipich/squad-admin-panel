{
  "name": "@squad/shared-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./admins-config": {
      "types": "./dist/admins-config.d.ts",
      "development": "./src/admins-config.ts",
      "default": "./dist/admins-config.js"
    },
    "./banned-names": {
      "types": "./dist/banned-names.d.ts",
      "development": "./src/banned-names.ts",
      "default": "./dist/banned-names.js"
    },
    "./role-colors": {
      "types": "./dist/role-colors.d.ts",
      "development": "./src/role-colors.ts",
      "default": "./dist/role-colors.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "development": "./src/permissions.ts",
      "default": "./dist/permissions.js"
    },
    "./squad-permissions": {
      "types": "./dist/squad-permissions.d.ts",
      "development": "./src/squad-permissions.ts",
      "default": "./dist/squad-permissions.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist .turbo",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
