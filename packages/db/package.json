{
  "name": "@squad/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "development": "./src/schema/index.ts",
      "default": "./dist/schema/index.js"
    },
    "./seed": {
      "types": "./dist/seed/system-roles.d.ts",
      "development": "./src/seed/system-roles.ts",
      "default": "./dist/seed/system-roles.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@squad/shared-config": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "postgres": "^3.4.5",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/uuid": "^11.0.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
