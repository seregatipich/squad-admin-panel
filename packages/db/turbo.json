{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_EXTENDS$", "!drizzle/**", "!sql/**", "!drizzle.config.ts"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "outputs": [".cache/typecheck.tsbuildinfo"]
    }
  }
}
