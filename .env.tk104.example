# tk104 production env for compose.tk104.yml — copy to .env.tk104 on the host and fill.
# .env.tk104 is gitignored; NEVER commit real secrets.

# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate: openssl rand -hex 32
SESSION_SECRET=

# Must decode to exactly 32 bytes. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# DuckDNS API token for Caddy DNS-01 TLS on tk104.duckdns.org (port 80 is not forwarded).
DUCKDNS_TOKEN=

# Let's Encrypt account email.
ACME_EMAIL=poluektovsergei345@gmail.com

# Optional — Steam Web API key for profile enrichment (login works without it).
STEAM_API_KEY=
STEAM_WEB_API_KEY=

SESSION_TTL_SECONDS=21600
SESSION_TOUCH_THROTTLE_SECONDS=60
