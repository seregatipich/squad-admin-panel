# ======================================================================
# scripts/verify.sh — optional long-lived local DB for the completion gate.
# Copy to .env.local (gitignored) if you keep a standing local Postgres/Redis
# running and want `scripts/verify.sh` to use it directly instead of
# provisioning a fresh one on every run. Not required — without this file,
# verify.sh falls back to the same auto-provisioning as
# scripts/pre-push-checklist.sh.
# ======================================================================

DATABASE_URL=postgres://admin:<password>@127.0.0.1:5432/admin
TEST_DATABASE_URL=postgres://admin:<password>@127.0.0.1:5432/admin
REDIS_URL=redis://127.0.0.1:6379
