{
  "name": "@squad/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "tsc -p tsconfig.json",
    "mint:owner-session": "tsx --conditions=development src/tools/mint-owner-session.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --dir test/integration",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.3.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.0.1",
    "@squad/bridge-client": "workspace:*",
    "@squad/db": "workspace:*",
    "@squad/diag": "workspace:*",
    "@squad/shared-config": "workspace:*",
    "@squad/shared-types": "workspace:*",
    "@squad/steam-api": "workspace:*",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "@prometheus-io/client": "^0.16.1",
    "ssh2": "1.17.0",
    "uuid": "^14.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/ssh2": "1.15.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "undici": "^8.5.0",
    "vitest": "^3.2.7",
    "ws": "^8.21.1"
  }
}
