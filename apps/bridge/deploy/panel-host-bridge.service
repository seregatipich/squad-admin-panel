[Unit]
Description=panel-host-bridge privileged daemon (squad-admin-panel)
Documentation=https://github.com/breaking-squad/squad-admin-panel
Requires=panel-host-bridge.socket
After=panel-host-bridge.socket network.target docker.service

[Service]
Type=notify
ExecStart=/usr/local/bin/panel-host-bridge
User=root
Restart=on-failure
RestartSec=2s
StartLimitIntervalSec=120
StartLimitBurst=5
WatchdogSec=30s

UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# ProcSubset must stay `all` (the default): the bridge reads host_info /
# host_metrics from /proc/cpuinfo, /proc/meminfo, /proc/stat, /proc/net/dev,
# /proc/uptime and /proc/loadavg. Setting ProcSubset=pid silently hides
# everything non-PID-related, which makes cpu_model / ram_total / cpu_percent
# collapse to their zero values.
ProcSubset=all
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@debug @mount @swap @reboot @obsolete @cpu-emulation @raw-io
SystemCallErrorNumber=EPERM

LogsDirectory=panel-host-bridge
ReadWritePaths=/var/lib/squad-panel /var/log/panel-host-bridge /etc/ufw /run/docker.sock /run/panel-host-bridge /run/squad-panel
DeviceAllow=

CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
