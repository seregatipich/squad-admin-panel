# ======================================================================
# Squad Admin Panel — environment variables
# Copy to .env and fill in the blanks before `docker compose up -d`.
# ======================================================================

# --- Public-facing --------------------------------------------------------

# FQDN under which Caddy serves the panel. Required.
# Use admin.localhost in dev (with TLS_ISSUER=internal) or a real domain in prod.
APP_DOMAIN=admin.localhost

# TLS mode. "internal" → Caddy's self-signed (dev), "acme" → Let's Encrypt (prod).
TLS_ISSUER=internal

# Email for Let's Encrypt. Required when TLS_ISSUER=acme.
ACME_EMAIL=admin@example.com

# DuckDNS API token for Caddy DNS-01 TLS (compose.tk104.yml / Caddyfile.tk104).
# Only needed when serving a *.duckdns.org domain without port 80 forwarded.
DUCKDNS_TOKEN=

# --- Secrets (REQUIRED — generate fresh for every install) ----------------

# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# Generate: openssl rand -base64 32 (32 bytes → base64 → decoded to 32-byte key)
# Loses this key = cannot decrypt stored RCON passwords / license keys /
# Discord bot tokens / Discord webhook URLs (all encrypted at-rest with it).
# Save it offline before first start.
APP_ENCRYPTION_KEY=

# Generate: openssl rand -base64 32
SESSION_SECRET=

# Optional: enables POST /api/v1/integrations/vip/lifecycle for vip-user-service.
# Generate: openssl rand -base64 32
VIP_LIFECYCLE_WEBHOOK_SECRET=

# --- Internal ------------------------------------------------------------

DATABASE_URL=postgres://admin:${POSTGRES_PASSWORD}@postgres:5432/admin
REDIS_URL=redis://redis:6379
BRIDGE_SOCKET=/run/panel-host-bridge/bridge.sock

# --- Host bridge / bind mounts --------------------------------------------

# `scripts/install-host-bridge.sh` and `scripts/bootstrap.sh` update these
# values to match the host. Manual compose deploys must keep them in sync with
# the actual data tree, the systemd drop-in, and the host `panel` group GID.
PANEL_GID=987
DATA_DIR=./data

# Base directory for uploaded media (video/image files land at
# <MEDIA_STORAGE_DIR>/<yyyy>/<mm>/<uuid>.<ext>). Mount this on persistent
# storage in production — it is not covered by the DB backup.
MEDIA_STORAGE_DIR=./media

# --- OAuth / OpenID (optional; stubs until Phase 1) ----------------------

PANEL_PUBLIC_URL=https://panel.example
STEAM_WEB_API_KEY=
STEAM_API_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_TTL_SECONDS=21600
SESSION_TOUCH_THROTTLE_SECONDS=60

# --- Observability (optional) --------------------------------------------

GLITCHTIP_DSN=
GLITCHTIP_SECRET_KEY=

# --- Backup (optional but recommended for prod) --------------------------

# The `backup` profile (docker compose --profile backup up -d) runs pg_dump and
# redis-cli inside the restic image; both reuse POSTGRES_PASSWORD above — no new
# secret. Logical dumps land under ${DATA_DIR}/backup-dump before restic
# snapshots them. Restore with scripts/restore.sh. Example RESTIC_REPOSITORY:
# s3:s3.amazonaws.com/my-admin-backups or /srv/backups
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# --- Worker intervals (optional) -----------------------------------------

# Daily SEED-2 reward-role reconciliation interval (milliseconds).
SEED_REWARD_INTERVAL_MS=86400000

# --- Worker one-shot flags (optional) -------------------------------------

# Set to 1 to make worker-presence-daily run a full ALT-3 co-play rebuild
# (recomputeCoplayForAllSessions over every day with session data) once at
# startup, before its regular hourly tick. Administrative command — run it
# one-shot (e.g. `docker compose run --rm -e COPLAY_FULL_REBUILD=1
# worker-presence-daily`), not by setting it on the long-running service.
COPLAY_FULL_REBUILD=
