# ======================================================================
# Squad Admin Panel — environment variables
# Copy to .env and fill in the blanks before `docker compose up -d`.
# ======================================================================

# --- Public-facing --------------------------------------------------------

# FQDN under which Caddy serves the panel. Required.
# Use admin.localhost in dev (with TLS_ISSUER=internal) or a real domain in prod.
APP_DOMAIN=admin.localhost

# TLS mode. "internal" → Caddy's self-signed (dev), "acme" → Let's Encrypt (prod).
TLS_ISSUER=internal

# Email for Let's Encrypt. Required when TLS_ISSUER=acme.
ACME_EMAIL=admin@example.com

# DuckDNS API token for Caddy DNS-01 TLS (compose.tk104.yml / Caddyfile.tk104).
# Only needed when serving a *.duckdns.org domain without port 80 forwarded.
DUCKDNS_TOKEN=

# --- Secrets (REQUIRED — generate fresh for every install) ----------------

# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# Generate: openssl rand -base64 32 (32 bytes → base64 → decoded to 32-byte key)
# Loses this key = cannot decrypt stored RCON passwords / license keys /
# Discord bot tokens / Discord webhook URLs (all encrypted at-rest with it).
# Save it offline before first start.
APP_ENCRYPTION_KEY=

# Generate: openssl rand -base64 32
SESSION_SECRET=

# Optional: enables POST /api/v1/integrations/vip/lifecycle for vip-user-service.
# Generate: openssl rand -base64 32
VIP_LIFECYCLE_WEBHOOK_SECRET=

# Optional: enables POST /api/v1/integrations/balancer/proposals, the inbound
# webhook the SquadJS team-balancer exporter pushes dry-run proposal snapshots
# to (GAME-2, #81). Unset = the endpoint is disabled and returns 503.
# Must be shared verbatim with the exporter. Generate: openssl rand -base64 32
BALANCER_WEBHOOK_SECRET=

# --- Internal ------------------------------------------------------------

DATABASE_URL=postgres://admin:${POSTGRES_PASSWORD}@postgres:5432/admin
REDIS_URL=redis://redis:6379
BRIDGE_SOCKET=/run/panel-host-bridge/bridge.sock

# --- Host bridge / bind mounts --------------------------------------------

# `scripts/install-host-bridge.sh` and `scripts/bootstrap.sh` update these
# values to match the host. Manual compose deploys must keep them in sync with
# the actual data tree, the systemd drop-in, and the host `panel` group GID.
PANEL_GID=987
DATA_DIR=./data

# Base directory for uploaded media (video/image files land at
# <MEDIA_STORAGE_DIR>/<yyyy>/<mm>/<uuid>.<ext>). Mount this on persistent
# storage in production — it is not covered by the DB backup.
# Both compose files pin api and worker-media-publisher to the shared
# `media_data` volume at /var/lib/squad-panel/media; the two containers have
# different WORKDIRs, so a relative path would give them separate directories
# and the publisher would find nothing to upload.
MEDIA_STORAGE_DIR=./media

# --- Media publishing to community channels (VIDEO-4, optional) -----------
#
# Fan-out of published clips to YouTube and/or Telegram, performed by
# worker-media-publisher. Each destination is independent and **off unless
# fully configured** — a publication queued for an unconfigured destination is
# deferred and retried later, never failed, so credentials can be added after
# the fact and the backlog drains on its own.
#
# These values are secrets: they are read only by the worker, are never
# returned by the API (GET /api/v1/integrations/media-publishing reports
# presence as a boolean and nothing else), and are scrubbed out of any error
# stored on a publication row or emitted to logs/diag.

# YouTube Data API v3, OAuth 2.0 installed-app credentials from
# https://console.cloud.google.com/apis/credentials. All three are required;
# with any of them blank the YouTube destination stays disabled. Obtain
# YOUTUBE_REFRESH_TOKEN once, offline, for an account that owns the target
# channel and has granted the youtube.upload scope.
# Uploads are created as `unlisted`.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Telegram bot credentials from @BotFather. Both are required; with either
# blank the Telegram destination stays disabled. The bot must be an admin of
# the target chat. TELEGRAM_CHAT_ID is either an @channelusername or a numeric
# id (a supergroup/channel looks like -1001234567890) — note that only those
# two forms yield a public message URL; for any other chat the publication
# still succeeds but external_url stays empty.
# The Bot API caps uploads at 50 MiB, so larger clips are rejected for
# Telegram (use YouTube for those).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Poll interval and per-tick batch size for worker-media-publisher.
MEDIA_PUBLISHER_INTERVAL_MS=60000
MEDIA_PUBLISHER_BATCH_SIZE=3

# --- Единый вход через bss.games -----------------------------------------

PANEL_PUBLIC_URL=https://panel.example
# Эти три значения обязательны вместе. Сайт использует зеркальные
# PANEL_SSO_PUBLIC_URL / PANEL_SSO_CLIENT_ID / PANEL_SSO_CLIENT_SECRET.
# Единственный callback панели:
#   <PANEL_PUBLIC_URL>/api/v1/auth/bss/callback
BSS_SITE_URL=https://bss.games
BSS_SSO_CLIENT_ID=squad-admin-panel
# Создайте один раз и храните только в закрытых хранилищах сайта и панели:
#   openssl rand -hex 32
BSS_SSO_CLIENT_SECRET=
# Необязательный второй секрет нужен только на время ротации.
BSS_SSO_CLIENT_SECRET_NEXT=

# --- Внешние профили и привязка Discord ---------------------------------

# Steam Web API key from https://steamcommunity.com/dev/apikey.
# Empty disables profile enrichment, friend checks and INT-1 refresh.
STEAM_API_KEY=
# Background Steam profile refresh sweep (default: once per hour).
STEAM_REFRESH_INTERVAL_MS=3600000

# Discord OAuth2 application credentials, used by the account-link flow
# (DISCORD-4). Leave both blank to disable it: GET /api/v1/auth/discord/login
# then answers 503 `oauth_not_configured` instead of redirecting.
# The Discord application MUST have this exact redirect URI registered:
#   <PANEL_PUBLIC_URL>/api/v1/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SESSION_TTL_SECONDS=21600
SESSION_TOUCH_THROTTLE_SECONDS=60

# --- Observability (optional) --------------------------------------------

GLITCHTIP_DSN=
GLITCHTIP_SECRET_KEY=

# --- Backup (optional but recommended for prod) --------------------------

# The `backup` profile (docker compose --profile backup up -d) runs pg_dump and
# redis-cli inside the restic image; both reuse POSTGRES_PASSWORD above — no new
# secret. Logical dumps land under ${DATA_DIR}/backup-dump before restic
# snapshots them. Restore with scripts/restore.sh. Example RESTIC_REPOSITORY:
# s3:s3.amazonaws.com/my-admin-backups or /srv/backups
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# --- Worker intervals (optional) -----------------------------------------

# Daily SEED-2 reward-role reconciliation interval (milliseconds).
SEED_REWARD_INTERVAL_MS=86400000

# VIPSUB-1 role-expirer tick interval — clears expired role grants (milliseconds).
ROLE_EXPIRER_INTERVAL_MS=60000

# VIPSUB-4 daily VIP expiry reminder pass in worker-role-expirer (milliseconds).
ROLE_EXPIRY_REMINDER_INTERVAL_MS=86400000

# VIPSUB-5 subscription renewal pass in worker-role-expirer (milliseconds).
# Each pass charges the snapshot price of every subscription whose
# next_renewal_at has come due; hourly keeps billing punctual without
# hammering the bonus ledger.
VIP_RENEWAL_INTERVAL_MS=3600000

# CFG-2 generic config-drift sweep interval for the config-sync worker
# (milliseconds). Compares every non-managed config file's on-disk sha256
# against its config_versions tip and publishes config-drift:status:<id>.
CONFIG_DRIFT_INTERVAL_MS=300000

# DOSSIER-4 leaderboard-aggregator recompute tick interval (milliseconds).
LEADERBOARD_AGGREGATOR_INTERVAL_MS=900000

# DOSSIER-4 one-shot combat backfill: how many calendar months of
# player_stat_periods month rows to recompute once at worker startup
# (0 = disabled).
LEADERBOARD_BACKFILL_MONTHS=0

# --- Worker one-shot flags (optional) -------------------------------------

# Set to 1 to make worker-presence-daily run a full ALT-3 co-play rebuild
# (recomputeCoplayForAllSessions over every day with session data) once at
# startup, before its regular hourly tick. Administrative command — run it
# one-shot (e.g. `docker compose run --rm -e COPLAY_FULL_REBUILD=1
# worker-presence-daily`), not by setting it on the long-running service.
COPLAY_FULL_REBUILD=
