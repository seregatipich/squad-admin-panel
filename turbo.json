{
  "$schema": "https://turborepo.org/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "biome.json", ".env.example"],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "DATABASE_URL",
    "POSTGRES_PASSWORD",
    "TEST_DATABASE_URL",
    "REDIS_URL",
    "TEST_REDIS_URL",
    "APP_ENCRYPTION_KEY",
    "PANEL_BRIDGE_SOCKET"
  ],
  "globalPassThroughEnv": ["VITEST_MAX_FORKS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "dependsOn": ["build", "^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["build", "^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build", "^build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:mutation": {
      "dependsOn": ["build", "^build"],
      "outputs": ["reports/mutation/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
