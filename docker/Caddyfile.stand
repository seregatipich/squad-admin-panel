{
	email {$ACME_EMAIL}
	servers {
		metrics
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
	}

	# Operator-only (#9, #47): Prometheus metrics and the dependency probe,
	# which runs a Postgres query, a Redis PING and a bridge RPC per request.
	# Scrape and probe them on the compose network (api:3000), never from here.
	@internal path /metrics* /ready*
	handle @internal {
		respond 404
	}

	@api path /api/* /health
	handle @api {
		reverse_proxy api:3000 {
			header_up X-Request-Id {http.request.header.X-Request-Id}
			health_uri /health
			health_interval 15s
		}
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}

# SquadCalc, a separate static site (plus the overlay relay under /relay/*) served by its own
# service on the stand host, not by this stack: Caddy only terminates TLS and proxies to it.
# DuckDNS resolves every subdomain of APP_DOMAIN to the host and the same token answers the
# DNS-01 challenge, so the subdomain needs no DNS or certificate setup of its own.
# SQUADCALC_UPSTREAM defaults to port 9910 of the host (host.docker.internal, see compose.stand.yml).
calc.{$APP_DOMAIN} {
	encode zstd gzip

	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
		resolvers 1.1.1.1 8.8.8.8
	}

	reverse_proxy {$SQUADCALC_UPSTREAM:host.docker.internal:9910}

	log {
		output stdout
		format json
	}
}
