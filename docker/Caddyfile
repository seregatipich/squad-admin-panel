{
	email {$ACME_EMAIL:admin@example.com}
	default_sni {$APP_DOMAIN:admin.localhost}
	servers {
		metrics
	}
}

{$APP_DOMAIN:admin.localhost}, https://{$APP_IP:127.0.0.1} {
	encode zstd gzip

	tls {
		issuer {$TLS_ISSUER:internal}
	}

	# Operator-only (#9, #47): Prometheus metrics and the dependency probe,
	# which runs a Postgres query, a Redis PING and a bridge RPC per request.
	# Scrape and probe them on the compose network (api:3000), never from here.
	@internal path /metrics* /ready*
	handle @internal {
		respond 404
	}

	@api path /api/* /health
	handle @api {
		reverse_proxy api:3000 {
			header_up X-Request-Id {http.request.header.X-Request-Id}
			health_uri /health
			health_interval 15s
		}
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format json
	}
}
