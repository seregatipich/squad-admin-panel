{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/git-guard-hook.sh\"",
            "timeout": 30,
            "statusMessage": "Checking git command against the branch model"
          }
        ]
      }
    ]
  }
}
